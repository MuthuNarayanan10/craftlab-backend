# Copy to .env (local) or set these in Render → Environment. NEVER commit the real values.
NODE_ENV=production
PORT=4000

# ---- Database ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/craftlab?retryWrites=true&w=majority

# ---- Security (generate each with:  openssl rand -hex 32) ----
JWT_SECRET=
SECRETS_KEY=            # encrypts courier / SMS / WhatsApp API keys saved from the admin. Keep it safe: losing it means re-entering those keys.
OTP_HMAC_SECRET=        # optional — falls back to JWT_SECRET
CORS_ORIGIN=https://thecraftlab.co.in,https://www.thecraftlab.co.in
SITE_URL=https://thecraftlab.co.in   # used in tracking links inside emails / WhatsApp messages

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Resend) ----
# --- Email login codes (OTP) — the ONLY OTP setup needed: fill these two and customers can log in with an emailed code ---
BREVO_API_KEY=          # Brevo → SMTP & API → API Keys
BREVO_SENDER_EMAIL=     # the email you signed up to Brevo with (or any address verified under Senders)
BREVO_SENDER_NAME=The Craft Lab
# These same Brevo variables also send ORDER emails, support-ticket emails and your new-order / new-ticket alerts.
# Alerts go to this mailbox (comma-separate several). Leave empty to use Admin → Settings → business email (care@thecraftlab.co.in).
OWNER_ALERT_EMAIL=care@thecraftlab.co.in

RESEND_API_KEY=
RESEND_FROM=The Craft Lab <care@thecraftlab.co.in>

# ---- First admin login (used once by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@thecraftlab.co.in
SEED_ADMIN_PASSWORD=

# ---- Optional ----
FIREBASE_SERVICE_ACCOUNT_JSON=   # only if you choose Firebase as the OTP provider
DISABLE_JOBS=false               # set true on a second instance so background jobs run only once
ALLOW_DEV_OTP=false              # NEVER true in production — the "dev" OTP provider prints codes to the log
