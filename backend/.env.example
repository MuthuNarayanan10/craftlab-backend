# Copy to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (see README.md)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/craftlab?retryWrites=true&w=majority

PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5500,https://thecraftlab.co.in

# --- Admin auth ---
# Long random string for signing admin JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
# Set this after creating a webhook in the Razorpay dashboard (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# --- Transactional email (optional — order confirmation/status emails) ---
# Sign up free at resend.com, verify your domain, get an API key.
# If left blank, emails are skipped (logged to console) — never blocks checkout.
RESEND_API_KEY=
RESEND_FROM=The Craft Lab <care@thecraftlab.co.in>

# --- Customer OTP login (Firebase Phone Auth — free) ---
# Firebase Console → Project Settings → Service Accounts → Generate New
# Private Key → paste the ENTIRE downloaded JSON file as one line here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Seed script (used once to create the first admin login) ---
SEED_ADMIN_EMAIL=admin@thecraftlab.co.in
SEED_ADMIN_PASSWORD=change-this-before-running-seed
