{
  "name": "craftlab-backend",
  "version": "1.0.0",
  "description": "Production e-commerce backend for The Craft Lab",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/core.test.js tests/otp.test.js tests/ops.test.js tests/app.test.js tests/delivery.test.js tests/catalog.test.js",
    "migrate": "node scripts/migrate-v4.js",
    "smoke": "node scripts/smoke-test.js",
    "test:e2e": "FERRET=1 node --test --test-timeout=70000 tests/e2e.test.js",
    "dev:ui": "FERRET=1 node tests/support/ui-server.js",
    "reset-admin": "node scripts/reset-admin.js",
    "race": "node scripts/race-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "razorpay": "^2.9.4",
    "compression": "^1.7.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}